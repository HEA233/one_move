# Local UI and fixture-only developer smoke tests are the defaults.
AI_PROVIDER=mock
ENABLE_LIVE_AI_SMOKE=false
FREE_TIER_CONFIRMED=false
ALLOW_PAID_AI=false
ALLOW_EXTERNAL_AI_IN_WEB=false

# Set only after checking account eligibility; keys stay in .env.local.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=

# Use an explicitly authorized disposable test project and apply its migration.
ENABLE_DB_SMOKE=false
SUPABASE_URL=
SUPABASE_PROJECT_REF=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Public origin only; localhost cannot be reached from another device.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
