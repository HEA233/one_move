{
  "name": "ghosted-prep",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.1.0 <25"
  },
  "packageManager": "npm@11.3.0",
  "scripts": {
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "NEXT_TELEMETRY_DISABLED=1 next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:env": "tsx scripts/check-env.ts",
    "check:boundaries": "tsx scripts/check-boundaries.ts",
    "smoke:db": "tsx scripts/smoke-db.ts",
    "smoke:ai:text": "tsx scripts/smoke-ai-text.ts",
    "smoke:ai:image": "tsx scripts/smoke-ai-image.ts"
  },
  "dependencies": {
    "@google/genai": "2.26.0",
    "@supabase/supabase-js": "2.117.2",
    "lucide-react": "1.49.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@next/env": "16.3.8",
    "@next/eslint-plugin-next": "16.3.8",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.11.0",
    "globals": "16.4.0",
    "postcss": "8.5.28",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  }
}
